# Copia para .env.local. Nunca faças commit de segredos.

# URL pública (links de partilha, passaporte, WhatsApp).
APP_URL=http://localhost:3200

# Dados de desenvolvimento opcionais, desactivados por omissão e indisponíveis em produção.
UKUPHILA_DEMO=0

# Base de dados. Sem DATABASE_URL usa PostgreSQL embutido (PGlite) em .data/pglite.
# Produção: Supabase pooler em modo transação (porta 6543).
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres
# Certificado da Supabase (PEM). Com ele, a ligação verifica o servidor.
# DATABASE_CA_CERT=

# Segredos do servidor. Em produção são obrigatórios: openssl rand -base64 32
# AUTH_SECRET=
# DOCUMENT_KEY=
# CRON_SECRET=

# Armazenamento de documentos. Sem isto, ficam cifrados em .data/documents (só local).
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DOCUMENTS_BUCKET=documentos

# IA. Sem chave, funciona o intérprete determinístico (regras) e a pesquisa na base de conhecimento.
# ANTHROPIC_API_KEY=

# WhatsApp Cloud API. Configuração do canal de mensagens em /api/whatsapp.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
